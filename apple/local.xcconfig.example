// Local-only Apple signing and OAuth configuration placeholders.
// Copy this file to apple/local.xcconfig. Never commit the populated copy.
// Pass the populated file to xcodebuild with:
//   -xcconfig apple/local.xcconfig
// Do not store secrets in the repository, issue trackers, or shared logs.

// Signing team and identity for local Apple Development builds only.
// Leave these unset for ordinary unsigned local builds.
// DEVELOPMENT_TEAM =
// CODE_SIGN_IDENTITY = Apple Development
// CODE_SIGNING_ALLOWED = YES

// Public OAuth client configuration injected through Xcode build settings.
// These values are not authentication secrets.
// TERSA_OAUTH_CLIENT_ID = your-client-id.apps.googleusercontent.com
// TERSA_OAUTH_REDIRECT_SCHEME = app.tersa.oauth.your-local-scheme

// Optional non-confidential Desktop client secret for local token exchange.
// Prefer environment injection when possible. Never commit a populated value.
// TERSA_OAUTH_CLIENT_SECRET =
